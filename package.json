{
  "name": "neuralforge-workspace",
  "version": "1.0.3",
  "description": "Local-first agentic AI gateway foundry. Fuse every web AI subscription into one unified swarm orchestrator. No API keys. No cloud. No telemetry.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @neuralforge/api dev\" \"pnpm --filter @neuralforge/web dev\"",
    "build": "tsc -b",
    "test": "pnpm --filter @neuralforge/tests test && pnpm exec vitest run",
    "watch": "pnpm --filter @neuralforge/tests watch",
    "check": "tsc -b --force",
    "doctor": "pnpm --filter neuralforge doctor",
    "login": "pnpm --filter neuralforge login",
    "clean": "pnpm -r clean && rm -rf node_modules/.cache",
    "release": "pnpm publish -r",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
