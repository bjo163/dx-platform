{
  "name": "dx-platform-workspace",
  "version": "1.0.3",
  "description": "Local-first autonomous developer platform. Fuse every web AI subscription into one unified workflow engine. No API keys. No cloud. No telemetry.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @dx-platform/api dev\" \"pnpm --filter @dx-platform/web dev\"",
    "build": "tsc -b",
    "test": "pnpm --filter @dx-platform/tests test && pnpm exec vitest run",
    "watch": "pnpm --filter @dx-platform/tests watch",
    "check": "tsc -b --force",
    "doctor": "pnpm --filter dx-platform doctor",
    "login": "pnpm --filter dx-platform login",
    "clean": "pnpm -r clean && rm -rf node_modules/.cache",
    "release": "pnpm publish -r",
    "postinstall": "pnpm build",
    "brand:check": "node scripts/brand-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "dx-platform",
    "developer-experience",
    "autonomous-agents",
    "ai-gateway",
    "local-first",
    "no-api-keys",
    "agent-mesh",
    "browser-session",
    "chatgpt",
    "claude",
    "developer-tools"
  ],
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
