{
  "name": "wtagent",
  "version": "1.0.3",
  "description": "Turn ChatGPT Web (including Pro) into Codex. Turn Claude Web into Claude Code. Also DeepSeek, Gemini, Grok, Kimi, GLM. No API key, no MCP, no tunnel, no plugin.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter wtagent dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter wtagent test:unit",
    "test:integration": "pnpm --filter wtagent test:integration",
    "check": "pnpm -r check",
    "doctor": "pnpm --filter wtagent doctor",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules/.cache",
    "release": "pnpm publish -r",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}