{
  "name": "wtagent-workspace",
  "version": "1.0.3",
  "description": "Turn ChatGPT Web (including Pro) into Codex. Turn Claude Web into Claude Code. Also DeepSeek, Gemini, Grok, Kimi, GLM. No API key, no MCP, no tunnel, no plugin.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @wtagent/api dev\" \"pnpm --filter @wtagent/web dev\"",
    "build": "tsc -b",
    "test": "pnpm --filter @wtagent/tests test && pnpm exec vitest run",
    "watch": "pnpm --filter @wtagent/tests watch",
    "check": "tsc -b --force",
    "doctor": "pnpm --filter wtagent doctor",
    "login": "pnpm --filter wtagent login",
    "clean": "pnpm -r clean && rm -rf node_modules/.cache",
    "release": "pnpm publish -r",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}