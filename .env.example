# Environment example — every name below is read by the runtime, with the file that reads it.
# Nothing here is required to start the stack locally; defaults are dev-safe and the API binds to loopback.
#
# NOTE ON THE TWO PREFIXES (M01 finding, not yet unified):
#   NEURALFORGE_* is read by the API process entrypoint (apps/api/src/index.ts) and forwarded as options.
#   WTAGENT_* is read directly by the app factory (apps/api/src/app.ts), the backup CLI, the CLI i18n layer
#   and the config API (packages/config-api/src/config-api.ts).
#   They are NOT aliases of each other and there is no fallback between them.

# ---------------------------------------------------------------------------
# API process entrypoint — apps/api/src/index.ts (prefix NEURALFORGE_)
# ---------------------------------------------------------------------------

# Bind address. Defaults to 127.0.0.1. Any non-loopback value requires a JWT secret of >= 32 chars.
# NEURALFORGE_HOST=127.0.0.1

# Required only when binding outside loopback. Must be at least 32 characters.
# NEURALFORGE_JWT_SECRET=

# Workspace root the API resolves against. "auto" (default) walks up from the installed module.
# NEURALFORGE_PROJECT_ROOT=auto

# Where the PGlite database and legacy job store live. Default: <projectRoot>/.neuralforge
# NEURALFORGE_DATA_DIR=

# Default provider for new jobs. Default: chatgpt
# NEURALFORGE_PROVIDER=chatgpt

# Job execution timeout in ms. Unset means the job service default applies.
# NEURALFORGE_JOB_TIMEOUT_MS=

# How long terminal jobs are retained, in ms. Must be a positive safe integer.
# NEURALFORGE_JOB_TTL_MS=

# Comma-separated browser origins allowed to call the API from a web session.
# NEURALFORGE_CORS_ORIGINS=

# HTTP port. Default: 8080
# PORT=8080

# ---------------------------------------------------------------------------
# App factory / job pool + artifacts — apps/api/src/app.ts (prefix WTAGENT_)
# ---------------------------------------------------------------------------

# Worker concurrency. Default: 1
# WTAGENT_WORKERS=1

# Pool ceilings enforced per project and per provider. Defaults: 2 and 2
# WTAGENT_MAX_PER_PROJECT=2
# WTAGENT_MAX_PER_PROVIDER=2

# Resource caps passed to launched tool processes. Defaults: 4 cores, 2048 MB
# WTAGENT_MAX_CPU=4
# WTAGENT_MAX_MEMORY_MB=2048

# Timeout applied to job execution through the API layer, in ms.
# WTAGENT_JOB_TIMEOUT_MS=

# Signing secret for artifact preview tokens. Unset => /preview endpoints answer 503.
# WTAGENT_ARTIFACT_SECRET=

# Artifact retention and thumbnail cap. Defaults: 3600000 ms and 256 px
# WTAGENT_ARTIFACT_TTL_MS=3600000
# WTAGENT_ARTIFACT_THUMBNAIL_SIZE=256

# ---------------------------------------------------------------------------
# Backup CLI — apps/api/src/backup-cli.ts (prefix WTAGENT_)
# ---------------------------------------------------------------------------
# WARNING: this tool reads WTAGENT_DATA_DIR / WTAGENT_PROJECT_ROOT while the server reads the
# NEURALFORGE_ equivalents. Setting only the NEURALFORGE_ pair makes a backup run against a
# different directory than the live server. Set both until the prefixes are unified (M01/M03).
# WTAGENT_PROJECT_ROOT=
# WTAGENT_DATA_DIR=

# ---------------------------------------------------------------------------
# Config API defaults — packages/config-api/src/config-api.ts (prefix WTAGENT_)
# ---------------------------------------------------------------------------
# WTAGENT_PROVIDER=
# WTAGENT_MODEL=
# WTAGENT_BROWSER=
# WTAGENT_API_KEY=
# WTAGENT_TEMPERATURE=
# WTAGENT_MAX_TOKENS=

# ---------------------------------------------------------------------------
# CLI locale — packages/cli/src/i18n.ts
# ---------------------------------------------------------------------------
# Overrides host LANG / LC_ALL / LC_MESSAGES detection.
# WTAGENT_LANG=

# ---------------------------------------------------------------------------
# Web app (Next.js client — these values are inlined into the browser bundle)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_NEURALFORGE_API_URL=
# NEXT_PUBLIC_WTAGENT_API_URL=
