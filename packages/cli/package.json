{
  "name": "wtagent",
  "version": "1.0.3",
  "description": "Turn ChatGPT Web (including Pro) into Codex. Turn Claude Web into Claude Code. Also DeepSeek, Gemini, Grok, Kimi, GLM. No API key, no MCP, no tunnel, no plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiXian42/wtagent.git"
  },
  "homepage": "https://github.com/XiXian42/wtagent#readme",
  "bugs": {
    "url": "https://github.com/XiXian42/wtagent/issues"
  },
  "keywords": [
    "agent",
    "web-ai",
    "chatgpt",
    "cli",
    "local-tools",
    "browser"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0",
    "pnpm": ">=9.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wtagent": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "check": "tsc -b --noEmit",
    "doctor": "node dist/main.js doctor",
    "login": "node dist/main.js login",
    "dev": "node dist/main.js"
  },
  "dependencies": {
    "@wtagent/types": "workspace:*",
    "@wtagent/shared": "workspace:*",
    "@wtagent/protocol": "workspace:*",
    "@wtagent/policy": "workspace:*",
    "@wtagent/platform": "workspace:*",
    "@wtagent/browser": "workspace:*",
    "@wtagent/tools": "workspace:*",
    "@wtagent/artifacts": "workspace:*",
    "@wtagent/audio": "workspace:*",
    "@wtagent/image": "workspace:*",
    "@wtagent/session": "workspace:*",
    "@wtagent/runtime": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.10.1",
    "playwright-core": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
