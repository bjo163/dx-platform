{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@neuralforge/types": ["../types/dist"],
      "@neuralforge/shared": ["../shared/dist"],
      "@neuralforge/session": ["../session/dist"],
      "@neuralforge/browser": ["../browser/dist"],
      "@neuralforge/runtime": ["../runtime/dist"],
      "@neuralforge/policy": ["../policy/dist"],
      "@neuralforge/tools": ["../tools/dist"],
      "@neuralforge/platform": ["../platform/dist"]
    },
    "noEmit": false,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
