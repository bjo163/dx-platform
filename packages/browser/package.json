{
  "name": "@wtagent/browser",
  "version": "1.0.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wtagent/types": "workspace:*",
    "@wtagent/shared": "workspace:*",
    "@wtagent/platform": "workspace:*",
    "@wtagent/protocol": "workspace:*",
    "@wtagent/tools": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "playwright-core": "^1.62.0"
  }
}
