{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "paths": {
      "@wtagent/types": [
        "../types/dist"
      ],
      "@wtagent/shared": [
        "../shared/dist"
      ],
      "@wtagent/session": [
        "../session/dist"
      ],
      "@wtagent/browser": [
        "../browser/dist"
      ],
      "@wtagent/runtime": [
        "../runtime/dist"
      ],
      "@wtagent/policy": [
        "../policy/dist"
      ],
      "@wtagent/tools": [
        "../tools/dist"
      ],
      "@wtagent/platform": [
        "../platform/dist"
      ],
      "@wtagent/job": [
        "../job/dist"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../job"
    }
  ]
}
