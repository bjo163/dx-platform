{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@wtagent/types": ["../types/dist"],
      "@wtagent/shared": ["../shared/dist"],
      "@wtagent/tools": ["../tools/dist"],
      "@wtagent/protocol": ["../protocol/dist"],
      "@wtagent/session": ["../session/dist"],
      "@wtagent/runtime": ["../runtime/dist"],
      "@wtagent/mcp": ["../mcp/dist"],
      "@wtagent/image": ["../image/dist"],
      "@wtagent/artifacts": ["../artifacts/dist"],
      "@wtagent/audio": ["../audio/dist"],
      "@wtagent/job": ["../job/dist"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../types" },
    { "path": "../shared" },
    { "path": "../tools" },
    { "path": "../protocol" },
    { "path": "../session" },
    { "path": "../runtime" },
    { "path": "../mcp" },
    { "path": "../image" },
    { "path": "../artifacts" },
    { "path": "../audio" },
    { "path": "../job" }
  ]
}