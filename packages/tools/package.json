{
  "name": "@dx-platform/tools",
  "version": "1.0.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -b --force",
    "test": "vitest run --root ../.. packages/tools/test",
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dx-platform/types": "workspace:*",
    "@dx-platform/shared": "workspace:*",
    "@dx-platform/policy": "workspace:*",
    "@dx-platform/platform": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

