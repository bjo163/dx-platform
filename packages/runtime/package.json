{
  "name": "@dx-platform/runtime",
  "version": "1.0.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -b --force",
    "build": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dx-platform/types": "workspace:*",
    "@dx-platform/shared": "workspace:*",
    "@dx-platform/protocol": "workspace:*",
    "@dx-platform/browser": "workspace:*",
    "@dx-platform/session": "workspace:*",
    "@dx-platform/tools": "workspace:*",
    "@dx-platform/artifacts": "workspace:*",
    "@dx-platform/audio": "workspace:*",
    "@dx-platform/image": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

